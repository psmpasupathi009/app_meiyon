{
  "name": "@meiyon/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "prisma generate --schema=prisma/schema.prisma",
    "push": "dotenv -e ../../.env -- prisma db push --schema=prisma/schema.prisma",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "ping": "dotenv -e ../../.env -- tsx scripts/ping.ts",
    "purge-demo": "dotenv -e ../../.env -- tsx scripts/purge-demo.ts",
    "fix:office-unit-ids": "dotenv -e ../../.env -- tsx scripts/fix-null-office-unit-ids.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^8.0.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.0"
  }
}
